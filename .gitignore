
# --- Phase 7 hardening (2026-09-27) ---
# Virtualenvs: match both .venv and the .venvNNN variant actually in use
.venv/
.venv*/
venv/
env/

# Secrets: never commit these
.env
.env.*
!.env.example
*.pem
credentials.json
secrets.json

# Local data / databases
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Bulk third-party event payloads (multi-MB, re-obtainable from the source)
data/acled/

# Runtime output
logs/
tmp/
*.log

# Python bytecode — these were tracked before this rule existed
__pycache__/
*.py[cod]
*$py.class
